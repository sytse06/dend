# Mistral API Key for the D&D Dungeon Master AI
# Get your API key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=your_api_key_here

# Hugging Face API Token for deployment
# Get your token at: https://huggingface.co/settings/tokens
# Required to push to Hugging Face Spaces
HF_TOKEN=your_hf_token_here

# Pydantic Logfire write token for tracking/tracing
# Get your token at: https://logfire.pydantic.dev/ (project settings > write tokens)
# Optional: without it, logfire.configure(send_to_logfire="if-token-present") is a no-op
LOGFIRE_TOKEN=your_logfire_token_here
