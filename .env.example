# OpenRouter API Key for the D&D Dungeon Master AI (Gemma 4, via OpenRouter)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# Hugging Face API Token
# Get your token at: https://huggingface.co/settings/tokens
# Not required for the GitHub Actions deploy (that uses SSH) or for running app.py locally.
HF_TOKEN=your_hf_token_here

# NVIDIA API Key for NVIDIA Endpoints
# Get your API key at: https://build.nvidia.com/explore/discover
NVIDIA_API_KEY=your_nvidia_api_key_here

# Pydantic Logfire write token for tracking/tracing
# Get your token at: https://logfire.pydantic.dev/ (project settings > write tokens)
# Optional: without it, logfire.configure(send_to_logfire="if-token-present") is a no-op
LOGFIRE_TOKEN=your_logfire_token_here
